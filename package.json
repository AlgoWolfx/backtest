{
  "name": "backtest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/data.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "serve": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch:dukascopy": "node scripts/fetch-dukascopy.mjs",
    "verify": "vitest run --config vitest.verify.config.ts",
    "data:oanda": "node scripts/oanda.mjs",
    "data:dukascopy": "node scripts/dukascopy-full.mjs"
  },
  "dependencies": {
    "dukascopy-node": "1.50.0",
    "fflate": "0.8.3",
    "lightweight-charts": "5.2.1",
    "lzma": "2.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
